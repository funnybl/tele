diff --git a/Telegram/SourceFiles/tele/tele_image_ocr.cpp b/Telegram/SourceFiles/tele/tele_image_ocr.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4035753e46d943d80d4632f5508922a70bd715c8
--- /dev/null
+++ b/Telegram/SourceFiles/tele/tele_image_ocr.cpp
@@ -0,0 +1,254 @@
+#include "tele/tele_image_ocr.h"
+
+#include "tele/tele_options.h"
+#include "ui/style/style_core.h"
+
+#ifndef Q_OS_MAC
+#include <tesseract/capi.h>
+#include <QFile>
+#include <QPainter>
+#include <mutex>
+#endif
+
+namespace Tele {
+namespace {
+
+#ifndef Q_OS_MAC
+
+constexpr auto kMaxImageDimension = 4096;
+constexpr auto kRecognitionDeadline = 10000;
+constexpr auto kMaxWords = 10000;
+
+using EnginePointer = std::unique_ptr<
+	TessBaseAPI,
+	decltype(&TessBaseAPIDelete)>;
+using IteratorPointer = std::unique_ptr<
+	TessResultIterator,
+	decltype(&TessResultIteratorDelete)>;
+using MonitorPointer = std::unique_ptr<
+	ETEXT_DESC,
+	decltype(&TessMonitorDelete)>;
+
+[[nodiscard]] TessBaseAPI *ImageOcrEngine() {
+	static const auto model = [] {
+		auto file = QFile(u":/tele/ocr/eng.traineddata"_q);
+		return file.open(QIODevice::ReadOnly)
+			? file.readAll()
+			: QByteArray();
+	}();
+	static const auto engine = [] {
+		auto result = EnginePointer(
+			TessBaseAPICreate(),
+			&TessBaseAPIDelete);
+		if (result && !model.isEmpty()) {
+			const auto initialized = TessBaseAPIInit5(
+				result.get(),
+				model.constData(),
+				int(model.size()),
+				"eng",
+				tesseract::OEM_LSTM_ONLY,
+				nullptr,
+				0,
+				nullptr,
+				nullptr,
+				0,
+				false);
+			if (!initialized) {
+				TessBaseAPISetPageSegMode(
+					result.get(),
+					tesseract::PSM_SPARSE_TEXT);
+				return result;
+			}
+		}
+		result.reset();
+		return result;
+	}();
+	return engine.get();
+}
+
+[[nodiscard]] QString RecognizedText(
+		const TessResultIterator *iterator,
+		TessPageIteratorLevel level) {
+	const auto text = std::unique_ptr<const char, decltype(&TessDeleteText)>(
+		TessResultIteratorGetUTF8Text(iterator, level),
+		&TessDeleteText);
+	return text ? QString::fromUtf8(text.get()) : QString();
+}
+
+[[nodiscard]] QRect RecognizedBox(
+		const TessPageIterator *iterator,
+		TessPageIteratorLevel level,
+		double scaleX,
+		double scaleY) {
+	auto left = 0;
+	auto top = 0;
+	auto right = 0;
+	auto bottom = 0;
+	if (!TessPageIteratorBoundingBox(
+			iterator,
+			level,
+			&left,
+			&top,
+			&right,
+			&bottom)
+		|| right <= left
+		|| bottom <= top) {
+		return {};
+	}
+	return QRect(
+		int(style::ConvertScale(left * scaleX)),
+		int(style::ConvertScale(top * scaleY)),
+		std::max(1, int(style::ConvertScale((right - left) * scaleX))),
+		std::max(1, int(style::ConvertScale((bottom - top) * scaleY))));
+}
+
+[[nodiscard]] std::vector<QRect> RecognizedGlyphs(
+		const TessResultIterator *word,
+		const QString &text,
+		double scaleX,
+		double scaleY) {
+	auto symbols = IteratorPointer(
+		TessResultIteratorCopy(word),
+		&TessResultIteratorDelete);
+	if (!symbols) {
+		return {};
+	}
+	const auto page = TessResultIteratorGetPageIteratorConst(symbols.get());
+	auto result = std::vector<QRect>();
+	result.reserve(text.size());
+	auto recognized = QString();
+	do {
+		const auto symbol = RecognizedText(symbols.get(), tesseract::RIL_SYMBOL);
+		const auto box = RecognizedBox(
+			page,
+			tesseract::RIL_SYMBOL,
+			scaleX,
+			scaleY);
+		if (symbol.isEmpty() || box.isEmpty()) {
+			return {};
+		}
+		recognized += symbol;
+		if (recognized.size() > text.size()) {
+			return {};
+		}
+		result.insert(result.end(), symbol.size(), box);
+		if (TessPageIteratorIsAtFinalElement(
+				page,
+				tesseract::RIL_WORD,
+				tesseract::RIL_SYMBOL)) {
+			break;
+		}
+	} while (TessResultIteratorNext(symbols.get(), tesseract::RIL_SYMBOL));
+	return (recognized == text) ? result : std::vector<QRect>();
+}
+
+[[nodiscard]] Platform::TextRecognition::Result RecognizeBundledImageText(
+		const QImage &image) {
+	if (image.isNull()) {
+		return {};
+	}
+	static auto mutex = std::mutex();
+	const auto lock = std::lock_guard(mutex);
+	const auto engine = ImageOcrEngine();
+	if (!engine) {
+		return {};
+	}
+	const auto clear = gsl::finally([=] {
+		TessBaseAPIClear(engine);
+	});
+	auto input = (std::max(image.width(), image.height()) > kMaxImageDimension)
+		? image.scaled(
+			kMaxImageDimension,
+			kMaxImageDimension,
+			Qt::KeepAspectRatio,
+			Qt::SmoothTransformation)
+		: image;
+	if (input.isNull()) {
+		return {};
+	}
+	input.setDevicePixelRatio(1.);
+	if (input.hasAlphaChannel()) {
+		auto flattened = QImage(input.size(), QImage::Format_RGB32);
+		if (flattened.isNull()) {
+			return {};
+		}
+		flattened.fill(Qt::white);
+		{
+			auto painter = QPainter(&flattened);
+			painter.drawImage(QPoint(), input);
+		}
+		input = std::move(flattened);
+	}
+	input = input.convertToFormat(QImage::Format_Grayscale8);
+	if (input.isNull()) {
+		return {};
+	}
+	TessBaseAPISetImage(
+		engine,
+		input.constBits(),
+		input.width(),
+		input.height(),
+		1,
+		int(input.bytesPerLine()));
+	TessBaseAPISetSourceResolution(engine, 300);
+	auto monitor = MonitorPointer(TessMonitorCreate(), &TessMonitorDelete);
+	if (!monitor) {
+		return {};
+	}
+	TessMonitorSetDeadlineMSecs(monitor.get(), kRecognitionDeadline);
+	if (TessBaseAPIRecognize(engine, monitor.get())) {
+		return {};
+	}
+	auto result = Platform::TextRecognition::Result{ .success = true };
+	auto words = IteratorPointer(
+		TessBaseAPIGetIterator(engine),
+		&TessResultIteratorDelete);
+	if (!words) {
+		return result;
+	}
+	const auto page = TessResultIteratorGetPageIteratorConst(words.get());
+	const auto scaleX = double(image.width()) / input.width();
+	const auto scaleY = double(image.height()) / input.height();
+	do {
+		auto text = RecognizedText(words.get(), tesseract::RIL_WORD);
+		const auto box = RecognizedBox(page, tesseract::RIL_WORD, scaleX, scaleY);
+		if (text.isEmpty() || box.isEmpty()) {
+			continue;
+		}
+		auto glyphs = RecognizedGlyphs(words.get(), text, scaleX, scaleY);
+		result.items.push_back({
+			std::move(text),
+			box,
+			std::move(glyphs),
+		});
+	} while (result.items.size() < kMaxWords
+		&& TessResultIteratorNext(words.get(), tesseract::RIL_WORD));
+	return result;
+}
+
+#endif
+
+}
+
+bool ImageOcrSupported() {
+#ifdef Q_OS_MAC
+	return Platform::TextRecognition::IsAvailable();
+#else
+	return true;
+#endif
+}
+
+bool ImageOcrAvailable() {
+	return Platform::TextRecognition::IsAvailable()
+		|| (ImageTextSelection() && ImageOcrSupported());
+}
+
+Platform::TextRecognition::Result RecognizeImageText(const QImage &image) {
+#ifdef Q_OS_MAC
+	return Platform::TextRecognition::RecognizeText(image);
+#else
+	return RecognizeBundledImageText(image);
+#endif
+}
+
+}
