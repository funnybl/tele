+include(FetchContent)
+
+function(tele_add_image_ocr target_name)
+    if (APPLE)
+        return()
+    endif()
+
+    set(CMAKE_POLICY_VERSION_MINIMUM 3.13)
+    set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
+    set(CMAKE_POLICY_DEFAULT_CMP0091 NEW)
+    set(CMAKE_SKIP_INSTALL_RULES TRUE)
+    if (POLICY CMP0218)
+        cmake_policy(SET CMP0218 NEW)
+        set(CMAKE_POLICY_DEFAULT_CMP0218 NEW)
+        cmake_diagnostic(SET CMD_AUTHOR IGNORE RECURSE)
+    else()
+        foreach(setting
+            CMAKE_ERROR_DEPRECATED
+            CMAKE_WARN_DEPRECATED
+            CMAKE_SUPPRESS_DEVELOPER_ERRORS
+            CMAKE_SUPPRESS_DEVELOPER_WARNINGS)
+            if (DEFINED CACHE{${setting}})
+                set(saved_${setting} "$CACHE{${setting}}")
+                set(had_${setting} TRUE)
+            else()
+                set(had_${setting} FALSE)
+            endif()
+        endforeach()
+        set(CMAKE_ERROR_DEPRECATED FALSE CACHE INTERNAL "" FORCE)
+        set(CMAKE_WARN_DEPRECATED FALSE CACHE INTERNAL "" FORCE)
+        set(CMAKE_SUPPRESS_DEVELOPER_ERRORS TRUE CACHE INTERNAL "" FORCE)
+        set(CMAKE_SUPPRESS_DEVELOPER_WARNINGS TRUE CACHE INTERNAL "" FORCE)
+    endif()
+    set(BUILD_SHARED_LIBS OFF)
+    set(SW_BUILD OFF)
+    set(BUILD_PROG OFF)
+    set(BUILD_TRAINING_TOOLS OFF)
+    set(BUILD_TESTS OFF)
+    set(OPENMP_BUILD OFF)
+    set(GRAPHICS_DISABLED ON)
+    set(DISABLED_LEGACY_ENGINE ON)
+    set(ENABLE_NATIVE OFF)
+    set(DISABLE_TIFF ON)
+    set(DISABLE_ARCHIVE ON)
+    set(DISABLE_CURL ON)
+    set(INSTALL_CONFIGS OFF)
+    foreach(codec ZLIB PNG GIF JPEG TIFF WEBP OPENJPEG)
+        set(ENABLE_${codec} OFF)
+        set(${codec}_FOUND OFF)
+        set(${codec}_LIBRARIES "")
+        set(HAVE_LIB${codec} OFF)
+    endforeach()
+    set(OPENJPEG_SUPPORT OFF)
+    set(LIBWEBP_SUPPORT OFF)
+    set(HAVE_LIBJP2K OFF)
+    set(HAVE_LIBWEBP_ANIM OFF)
+    set(HAVE_LIBZ OFF)
+    set(WebP_LIBRARIES "")
+    set(LibArchive_FOUND OFF)
+    set(CURL_FOUND OFF)
+    set(OpenMP_CXX_FOUND OFF)
+
+    FetchContent_Declare(Leptonica
+        URL https://codeload.github.com/DanBloomberg/leptonica/tar.gz/refs/tags/1.85.0
+        URL_HASH SHA256=c01376bce0379d4ea4bc2ec5d5cbddaa49e2f06f88242619ab8c059e21adf233
+        DOWNLOAD_EXTRACT_TIMESTAMP TRUE
+        OVERRIDE_FIND_PACKAGE
+    )
+    FetchContent_MakeAvailable(Leptonica)
+    file(WRITE "${CMAKE_FIND_PACKAGE_REDIRECTS_DIR}/leptonica-extra.cmake"
+        "set(Leptonica_VERSION 1.85.0)\n"
+        "set(Leptonica_INCLUDE_DIRS \"${leptonica_SOURCE_DIR}/src;${leptonica_BINARY_DIR}/src\")\n"
+        "set(Leptonica_LIBRARIES leptonica)\n"
+    )
+
+    FetchContent_Declare(tele_tesseract
+        URL https://codeload.github.com/tesseract-ocr/tesseract/tar.gz/refs/tags/5.5.1
+        URL_HASH SHA256=a7a3f2a7420cb6a6a94d80c24163e183cf1d2f1bed2df3bbc397c81808a57237
+        DOWNLOAD_EXTRACT_TIMESTAMP TRUE
+    )
+    FetchContent_MakeAvailable(tele_tesseract)
+    if (NOT POLICY CMP0218)
+        foreach(setting
+            CMAKE_ERROR_DEPRECATED
+            CMAKE_WARN_DEPRECATED
+            CMAKE_SUPPRESS_DEVELOPER_ERRORS
+            CMAKE_SUPPRESS_DEVELOPER_WARNINGS)
+            if (had_${setting})
+                set(${setting} "${saved_${setting}}" CACHE INTERNAL "" FORCE)
+            else()
+                unset(${setting} CACHE)
+            endif()
+        endforeach()
+    endif()
+    set_target_properties(leptonica libtesseract PROPERTIES POSITION_INDEPENDENT_CODE ON)
+    set_target_properties(tesseract PROPERTIES EXCLUDE_FROM_ALL TRUE)
+    target_compile_definitions(libtesseract PRIVATE TESSERACT_DISABLE_DEBUG_FONTS)
+    target_include_directories(libtesseract BEFORE PRIVATE "${tele_tesseract_BINARY_DIR}")
+    target_include_directories(libtesseract PUBLIC "$<BUILD_INTERFACE:${tele_tesseract_BINARY_DIR}/include>")
+    target_link_libraries(${target_name} PRIVATE libtesseract)
+
+    set(ocr_dir "${CMAKE_CURRENT_BINARY_DIR}/tele_ocr")
+    file(MAKE_DIRECTORY "${ocr_dir}")
+    tele_download_ocr_file(
+        "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/4.1.0/eng.traineddata"
+        "${ocr_dir}/eng.traineddata"
+        7d4322bd2a7749724879683fc3912cb542f19906c83bcc1a52132556427170b2
+    )
+    tele_download_ocr_file(
+        "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/4.1.0/LICENSE"
+        "${ocr_dir}/tessdata-license.txt"
+        cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30
+    )
+    configure_file("${tele_tesseract_SOURCE_DIR}/LICENSE" "${ocr_dir}/tesseract-license.txt" COPYONLY)
+    configure_file("${leptonica_SOURCE_DIR}/leptonica-license.txt" "${ocr_dir}/leptonica-license.txt" COPYONLY)
+    file(WRITE "${ocr_dir}/tele_image_ocr.qrc"
+        "<RCC>\n<qresource prefix=\"/tele/ocr\">\n"
+        "<file>eng.traineddata</file>\n"
+        "<file>tesseract-license.txt</file>\n"
+        "<file>leptonica-license.txt</file>\n"
+        "<file>tessdata-license.txt</file>\n"
+        "</qresource>\n</RCC>\n"
+    )
+    target_sources(${target_name} PRIVATE "${ocr_dir}/tele_image_ocr.qrc")
+endfunction()
+
+function(tele_download_ocr_file url path hash)
+    if (EXISTS "${path}")
+        file(SHA256 "${path}" current_hash)
+        if ("${current_hash}" STREQUAL "${hash}")
+            return()
+        endif()
+    endif()
+    file(DOWNLOAD "${url}" "${path}"
+        EXPECTED_HASH SHA256=${hash}
+        TLS_VERIFY ON
+        STATUS result
+    )
+    list(GET result 0 status)
+    if (NOT status EQUAL 0)
+        list(GET result 1 error)
+        message(FATAL_ERROR "Could not download bundled OCR data: ${error}")
+    endif()
+endfunction()
