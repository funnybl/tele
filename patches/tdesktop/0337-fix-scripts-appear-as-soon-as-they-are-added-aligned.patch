 .../tele/scripting/tele_script_hooks.h        |  1 +
 .../tele/scripting/tele_script_manager.cpp    |  5 +++
 .../scripting/tele_script_mediaviewer.cpp     |  3 +-
 .../tele/scripting/tele_script_sound.cpp      |  3 ++
 .../tele/scripting/tele_script_stories.cpp    |  3 +-
 Telegram/SourceFiles/ui/menu_icons.style      |  1 +
 7 files changed, 54 insertions(+), 3 deletions(-)

diff --git a/Telegram/SourceFiles/tele/scripting/tele_script_hooks.cpp b/Telegram/SourceFiles/tele/scripting/tele_script_hooks.cpp
index d0f131f23fbbf04072fbb37ff183e6f6944c6081..04ca79983c82bbd1f254c2d02662396e53682f72 100644
--- a/Telegram/SourceFiles/tele/scripting/tele_script_hooks.cpp
+++ b/Telegram/SourceFiles/tele/scripting/tele_script_hooks.cpp
@@ -74,6 +74,7 @@ constexpr auto kMaxGranted = 256;
 constexpr auto kMaxEntries = quint32(4096);
 constexpr auto kMaxIdLength = 1024;
 constexpr auto kRefreshDelay = crl::time(300);
+constexpr auto kPollInterval = crl::time(2000);
 constexpr auto kToastMerge = crl::time(5000);
 constexpr auto kMaxPending = 4096;
 constexpr auto kRpcErrorId = std::uint32_t(0x2144ca19U);
@@ -754,6 +755,7 @@ public:
 	explicit Host(not_null<Main::Session*> session);
 	~Host();
 
+	void rescan();
 	[[nodiscard]] static Host *Find(not_null<MTP::Instance*> instance);
 	[[nodiscard]] static Host *Find(not_null<Main::Session*> session);
 	static void RefreshAll();
@@ -946,6 +948,7 @@ private:
 
 	void refresh();
 	void scheduleRefresh();
+	void poll();
 	void watch(const std::vector<ScriptFile> &files);
 	void start(Entry &entry, bool interactive);
 	void notify(const QString &id, const QString &text);
@@ -1018,6 +1021,7 @@ private:
 	MTP::Sender _api;
 	std::unique_ptr<QFileSystemWatcher> _watcher;
 	base::Timer _refreshTimer;
+	base::Timer _pollTimer;
 	rpl::event_stream<> _changes;
 	rpl::event_stream<ScriptLogged> _logged;
 	std::unique_ptr<Instance> _repl;
@@ -1031,13 +1035,15 @@ Host::Host(not_null<Main::Session*> session)
 , _mtp(&session->mtp())
 , _storage(session)
 , _api(&session->mtp())
-, _refreshTimer([=] { refresh(); }) {
+, _refreshTimer([=] { refresh(); })
+, _pollTimer([=] { poll(); }) {
 	Registry().emplace(_mtp, this);
 	read();
 	Folder().changes.events() | rpl::on_next([=] {
 		refresh();
 	}, _lifetime);
 	refresh();
+	_pollTimer.callEach(kPollInterval);
 }
 
 Host::~Host() {
@@ -1172,6 +1178,33 @@ void Host::scheduleRefresh() {
 	_refreshTimer.callOnce(kRefreshDelay);
 }
 
+void Host::rescan() {
+	_refreshTimer.cancel();
+	refresh();
+}
+
+void Host::poll() {
+	if (_refreshTimer.isActive()) {
+		return;
+	}
+	const auto files = Scan(ScriptsFolder());
+	auto same = (files.size() == _entries.size());
+	for (auto i = 0; same && i != int(files.size()); ++i) {
+		same = (files[i].id == _entries[i].file.id)
+			&& (files[i].entry == _entries[i].file.entry);
+	}
+	if (!same) {
+		scheduleRefresh();
+		return;
+	}
+	for (const auto &entry : _entries) {
+		if (entry.instance && Changed(entry.stamps)) {
+			scheduleRefresh();
+			return;
+		}
+	}
+}
+
 void Host::watch(const std::vector<ScriptFile> &files) {
 	_watcher = nullptr;
 	const auto folder = ScriptsFolder();
@@ -3080,6 +3113,12 @@ void ClearScriptLog(not_null<Main::Session*> session, const QString &id) {
 	}
 }
 
+void RescanScripts(not_null<Main::Session*> session) {
+	if (const auto host = Host::Find(session)) {
+		host->rescan();
+	}
+}
+
 void ReloadScript(not_null<Main::Session*> session, const QString &id) {
 	if (const auto host = Host::Find(session)) {
 		host->reload(id);
