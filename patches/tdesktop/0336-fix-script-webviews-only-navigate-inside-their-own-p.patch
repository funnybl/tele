From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nitreojs <hello@starkow.dev>
Date: Sun, 11 Oct 2026 17:31:01 +0300
Subject: [PATCH] fix: script webviews only navigate inside their own page

---
 .../SourceFiles/tele/scripting/tele_script_webview.cpp   | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/Telegram/SourceFiles/tele/scripting/tele_script_webview.cpp b/Telegram/SourceFiles/tele/scripting/tele_script_webview.cpp
index c8ad94a9039cdb1394c1ef2240d995c963e608e7..e0ea2d6c50adb34a54996eba64c5cd2299664654 100644
--- a/Telegram/SourceFiles/tele/scripting/tele_script_webview.cpp
+++ b/Telegram/SourceFiles/tele/scripting/tele_script_webview.cpp
@@ -519,9 +519,12 @@ bool Panel::createWebview(not_null<Instance*> instance, Options options) {
 				&& !host.isEmpty()
 				&& permissions.allows(Capability::Fetch, host.toStdString());
 		}
-		const auto external = (scheme == u"https"_q)
-			|| (scheme == u"http"_q && host != u"desktop-app-resource"_q);
-		return !external;
+		return (scheme == u"http"_q && host == u"desktop-app-resource"_q)
+			|| (scheme == u"http"_q && host == u"127.0.0.1"_q)
+			|| (scheme == u"desktopappresource"_q)
+			|| (scheme == u"about"_q)
+			|| (scheme == u"data"_q)
+			|| (scheme == u"blob"_q);
 	});
 	raw->setNavigationDoneHandler([=](bool) {
 		crl::on_main(this, [=] {
